# ==========================================
# Eventra Backend Environment Configuration
# ==========================================

# Server Environment
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventra?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_replace_with_64_character_string
JWT_EXPIRE=7d

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS Allowed Origin(s)
# For single-service deploy or wildcard: *
# For specific frontend domain(s), comma-separate:
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# Email Service (Free Hybrid: Resend API or auto-Ethereal browser preview)
# Get a free key at https://resend.com (3,000 free emails/month)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Eventra <onboarding@resend.dev>

# Optional Legacy SMTP (will fallback to Resend or Ethereal test inbox if omitted)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Stripe Payments (Optional - demo payment works out of the box if omitted)
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
